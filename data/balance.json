      "ammoLeftRatioAtAltar": 0.20,
      "corruptedAmmoUsageRatio": 0.30,
      "parryAttemptsPerEncounter": 3,
      "perfectParryRatio": 0.20,
      "manaWasteRatio": 0.30,
      "chainTier3ReachRatio": 0.20,
      "altarBypassRatio": 0.05
    }
  }
