    "combatExitTicks": 90,
    "decayPerTick": 1.2,
    "regenPerTick": 0.02,
    "regenCap": 30,
    "heartSigilBonus": 0.6
  },

  "spellCost": {
    "small": 22,
    "medium": 66,
    "large": 160
  },

  "weapons": {
    "pistol": {
      "ammoMax": 60,
      "damage": 34,
      "fireIntervalTicks": 14,
      "reloadTicks": 66,
      "magSize": 12,
      "pierceBarrier": true,
      "muzzleFlash": { "intensity": 3.0, "radiusMul": 0.5, "ticks": 2 },
      "tracerTicks": 8
    },
    "rifle": {
      "ammoMax": 180,
      "damage": 16,
      "fireIntervalTicks": 5,
      "reloadTicks": 96,
      "magSize": 30,
      "pierceBarrier": false,
      "muzzleFlash": { "intensity": 2.4, "radiusMul": 0.5, "ticks": 2 }
