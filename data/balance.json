  "corruptedAmmo": {
    "damageMul": 0.6,
    "spreadMul": 2.0,
    "pierceBarrier": false,
    "corruptionPer30Rounds": 1
  },

  "lantern": {
    "batteryMax": 100,
    "drainPerTick": 0.028,
    "spareCells": 2,
    "intensity": 1.6,
    "radius": 14.0,
    "angleDeg": 42,
    "penumbra": 0.35,
    "attractsCasterRangeMul": 1.8
