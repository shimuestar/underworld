{
  "_comment": "모든 튜닝값. 코드에 하드코딩 금지. 틱 단위는 60Hz 기준 정수.",

  "loop": {
    "tickRate": 60,
    "maxFrameClampSec": 0.25
  },

  "input": {
    "mouseSensitivity": 0.0023,
    "pitchMaxDeg": 89
  },

  "player": {
    "healthMax": 100,
    "moveSpeed": 6.0,
    "sprintSpeed": 9.0,
    "eyeHeight": 1.6,
    "radius": 0.4,
    "height": 1.8
