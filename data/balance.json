  "lighting": {
    "torchColor": "#FF8C3B",
    "torchIntensity": 2.2,
    "torchDistance": 9.0,
    "torchHeight": 2.6
  },

  "altar": {
    "radius": 2.4,
    "refillToMax": true,
    "aggressionBonus": {
      "meleeRatioWeight": 0.5,
      "perfectParryWeight": 0.3,
      "perfectParryCap": 10,
      "noDamageRatioWeight": 0.2,
      "maxMultiplier": 1.4
    }
  },

  "corruption": {
    "max": 100,
    "thresholds": [25, 50, 75, 90],
